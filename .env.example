# Telegram bot token
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated admin Telegram user IDs (numeric). Example: 12345678,23456789
ADMIN_IDS=YOUR_TELEGRAM_ID

# USDT receiving wallet address to display to users after acceptance
USDT_ADDRESS=your_usdt_wallet_address_here

# Comma-separated list of group chat IDs (numeric, include negative sign if needed)
# Example: -1001234567890,-1009876543210
# Get these by adding the bot to each group and using a tool to extract chat_id
GROUP_CHAT_IDS= -5004801923

# Logs/Admin group where you receive all deal receipts and status updates
# Create a private channel/group, add the bot, then get the chat ID
# Example: -1001234567890
LOGS_GROUP_ID=

# Optional: fee information shown to users after a deal is accepted

# Comma-separated list of payment methods for sellers
# Example: UPI,Bank Transfer,Cash,PayPal
PAYMENT_METHODS=UPI,Bank Transfer,CDM,Cash Deposit,PayPal

# Network-specific USDT receiving addresses
ADMIN_USDT_BSC=0x...
ADMIN_USDT_TRON=T...
ADMIN_USDT_BASE=0x...
ADMIN_USDT_SOL=...

# Network-specific USDC receiving addresses (Optional)
ADMIN_USDC_BSC=0x...
ADMIN_USDC_TRON=T...
ADMIN_USDC_BASE=0x...
ADMIN_USDC_SOL=...
